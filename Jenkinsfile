pipeline {
  agent any
  stages {
    stage('Build') {
      steps {
        sh 'echo "Compilation en cours..."'
      }
    }

    stage('Test') {
      steps {
        sh 'echo "Lancement des tests..."'
      }
    }

    stage('Deploy') {
      steps {
        sh 'echo "Déploiement terminé"'
      }
    }

  }
}